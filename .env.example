# Copy to .env (and .env.local for the Supabase values) and fill in. Never commit real values.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
GOOGLE_GENERATIVE_AI_API_KEY=
AMORPHIX_MODEL=
# At least 32 random characters; signs the guest and user cookies.
AMORPHIX_SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used by `npm run migrate`.
POSTGRES_URL_NON_POOLING=
