# Copy to .env.local and fill in. Never commit real values. The same keys go in Vercel's environment variables.

# Gemini, for the interviewer, the design agents and the taste descriptions.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: which Gemini model to use first.
AMORPHIX_MODEL=

# At least 32 random characters; signs the guest and user cookies.
AMORPHIX_SESSION_SECRET=

# Supabase: projects, accounts and files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Direct Postgres connection, used by `npm run migrate`.
POSTGRES_URL_NON_POOLING=

# YugabyteDB with pgvector: the taste vectors and nearest-neighbour search.
YUGABYTE_URL=
